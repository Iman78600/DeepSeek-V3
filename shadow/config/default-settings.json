  "proxy.mode": "direct",
  "proxy.url": "",
  "proxy.bypassList": "<local>",

  "dns.mode": "doh",
  "dns.dohUrl": "https://dns.quad9.net/dns-query",

  "hardening.javascript": true,
  "hardening.webrtc": "disabled",
  "hardening.canvasNoise": true,
  "hardening.fontProtection": true,
  "hardening.timingJitter": true,
  "hardening.blockThirdPartyCookies": true,
  "hardening.blockAllCookies": false,
  "hardening.stripClientHints": true,
  "hardening.stripServerHints": true,
  "hardening.dntAndGpc": true,
  "hardening.trimReferrer": true,
  "hardening.rewriteHeaders": true,
  "hardening.spoofUserAgent": true,
  "hardening.userAgent": "",
  "hardening.denyPermissions": true,
  "hardening.allowedPermissions": [],
  "hardening.blockWebgl": false,
  "hardening.disableWebAssembly": false,
  "hardening.sanitizeClipboard": true,

  "privacy.clearOnExit": true,
  "privacy.persistLog": true,
  "privacy.blockHistory": false,
  "privacy.searchEngine": "https://duckduckgo.com/?q=%s",
