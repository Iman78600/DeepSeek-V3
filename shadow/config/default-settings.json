{
  "profile.preset": "balanced",

  "soc.enabled": true,
  "soc.mode": "balanced",
  "soc.blockOnUrlVerdict": true,
  "soc.deepPageScan": true,
  "soc.reputationLookups": false,
  "soc.allowlist": [],

  "firewall.enabled": true,
  "firewall.httpsOnly": true,
  "firewall.blockPrivateNetwork": true,
  "firewall.blockTrackers": true,
  "firewall.blockAds": true,
  "firewall.blockMining": true,
  "firewall.lockdown": false,
  "firewall.blockThreshold": 10,
  "firewall.customRules": [],

  "sandbox.enabled": true,
  "sandbox.mode": "balanced",
  "sandbox.detonate": false,
  "sandbox.autoDeleteMalicious": false,
  "sandbox.releaseDir": "",
